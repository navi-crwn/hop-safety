{
  "name": "hop/harness-hop-safety",
  "description": "External test harness for hop/safety (tests copied from the package repo; repo untouched).",
  "repositories": [
    { "type": "path", "url": "../../hop-safety", "options": { "symlink": true } }
  ],
  "license": "MIT",
  "require": { "hop/safety": "*", "ext-intl": "*" },
  "autoload": {
    "psr-4": { "Tests\\": "tests/" }
  },
  "require-dev": {
    "pestphp/pest": "^3.0",
    "orchestra/testbench": "^10.0",
    "pestphp/pest-plugin-laravel": "^3.0"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": { "allow-plugins": { "pestphp/pest-plugin": true } }
}
